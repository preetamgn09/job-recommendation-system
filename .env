# ============================================
# Distributed Job Recommendation System
# Environment Configuration
# ============================================

# MongoDB
MONGO_URL=mongodb://mongodb:27017
MONGO_DB=job_recommendation

# Redis
REDIS_URL=redis://redis:6379
REDIS_TTL=300

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_MANAGEMENT_PORT=15672

# Service Ports
API_GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
JOB_SERVICE_PORT=8002
RECOMMENDATION_SERVICE_PORT=8003

# Service URLs (internal Docker network)
USER_SERVICE_URL=http://user-service:8001
JOB_SERVICE_URL=http://job-service:8002
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8003

# Logging
LOG_LEVEL=INFO

# Recommendation Engine
RECO_TOP_N=10
RECO_CONTENT_WEIGHT=0.7
RECO_ACTIVITY_WEIGHT=0.3
